# UniNotebook frontend configuration
#
# The backend serves the built frontend, so they share an origin and the API base URL can be
# left empty. Copy this to .env.production before running `npm run build`.

# API base URL. Empty means same-origin (the default setup).
VITE_API_BASE_URL=""

# Deployment mode. Setting this to `local` lets the UI hide the login and billing entry points
# on the very first paint, avoiding a brief flash of a login button.
# It also works without this — the frontend reads the real mode from
# /api/system/capabilities shortly after startup.
VITE_DEPLOY_MODE=local
