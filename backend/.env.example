# UniNotebook configuration (optional)
#
# Most people don't need this file — just run `python run.py` and paste your API keys into
# the Settings page. They're stored in ~/.uninotebook/credentials.json (mode 0600).
#
# Copy this to `.env.development` only if you'd rather manage configuration through
# environment variables, or need to change the default port or data directory.
#
# ⚠️ Never commit a .env with real keys. All .env* files are gitignored.

# ==================== Runtime ====================
# local = single-user local install (no login, SQLite, in-process tasks)
DEPLOY_MODE=local

# Data directory. Leave empty for ~/.uninotebook
LOCAL_DATA_DIR=

# Local execution limits (also configurable as environment variables)
LOCAL_TASK_WORKERS=4
LOCAL_DOCUMENT_TASK_WORKERS=2
LOCAL_TASK_QUEUE_LIMIT=100
LOCAL_TASK_TIMEOUT_SECONDS=900
LOCAL_EMBEDDING_CONCURRENCY=4

# Max size of a single uploaded file, in MB
MAX_UPLOAD_MB=50
# Add three sample documents the first time the data directory is empty (deleted samples never return)
SAMPLE_DOCUMENTS_ENABLED=true

# There is no login, so only localhost / IP-address Host headers are accepted (blocks DNS
# rebinding). List extra hostnames here (comma-separated) to reach it via a custom name; * disables the check.
LOCAL_ALLOWED_HOSTS=

# ==================== Model API keys ====================
# Configure at least one chat model below to get started.
# You can also leave these empty and fill them in from the Settings page.

# Moonshot Kimi        https://platform.moonshot.cn/
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# DeepSeek             https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Qwen (Alibaba Cloud Model Studio / DashScope)   https://bailian.console.aliyun.com/
# The base URL can also point at any compatible gateway that serves Qwen models.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# Any other OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio, …)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required when you use this endpoint: the exact model name it serves
OPENAI_MODEL=

# ==================== Embeddings (required for document features) ====================
# Uploaded documents must be embedded before they can be searched, so this is a
# prerequisite for anything document-related.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# Leave empty to use the model's native embedding size.
EMBEDDING_DIMENSIONS=
# Chat provider for every feature (qwen / moonshot / deepseek / openai);
# empty means automatically use a configured provider.
DEFAULT_CHAT_PROVIDER=

# ==================== Optional features ====================
# Academic posters need an image-generation key; without it the feature shows as unavailable.
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_GEN_MODEL=qwen-image-max

# Optional native DashScope speech/research key, separate from a custom embedding endpoint.
# An existing key for the official DashScope embedding endpoint can be reused automatically.
DASHSCOPE_NATIVE_API_KEY=

# ==================== Server ====================
API_HOST=127.0.0.1
API_PORT=8000

# ==================== No external services required ====================
# SQLite for the database, embedded ChromaDB for vectors, in-process background tasks —
# nothing extra to install. If you do happen to run Redis and want caching, set this to true.
REDIS_ENABLED=false

# Parsing strategy: simple (PyMuPDF/pypdf only) | hybrid (tables and formulas, needs extras)
DOCUMENT_PARSER_STRATEGY=simple
